# Van der Tweel / Cemagi Atelier platform
# Voorbeeldwaarden — echte waarden staan in Vercel env vars (productie + staging gescheiden, NFR 11.4)

# Database (Neon Postgres via Vercel Storage-integratie)
DATABASE_URL="postgresql://user:pass@host/db?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://user:pass@host/db?sslmode=require"

# Auth.js — magic-link zonder wachtwoord (TO 9.1)
AUTH_SECRET="genereer met: npx auth secret"
AUTH_RESEND_KEY="re_xxxxx"
AUTH_EMAIL_FROM="noreply@vandertweel.example"

# Bestandsopslag (foto's, documenten, 3D-modellen) — alleen url in db, niet de bytes (TO 6)
BLOB_READ_WRITE_TOKEN=""

# Monitoring (NFR 10.2)
SENTRY_DSN=""

# Canonical owner-platform origin for invitations and transactional notifications.
APP_URL=https://your-existing-live-domain.example

# Protect GET /api/jobs/mail. Configure an external scheduled invocation every
# minute for retries; ordinary writes also wake the durable outbox immediately.
# Generate a long random secret through the hosting environment, not in source.
CRON_SECRET=

# Production uploads require a PRIVATE Vercel Blob store with the token above.
# Never configure FILE_STORAGE_DRIVER=local or MAIL_TRANSPORT=local-capture in production.
